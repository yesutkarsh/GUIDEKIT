  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.10.0",
    "jsdom": "^24.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
