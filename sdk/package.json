{
  "name": "@guidekit/sdk",
  "version": "0.1.0",
  "type": "module",
  "description": "Universal Web SDK with Spotlight Engine, 4-Tier DOM Resolver, and Shadow DOM Chatbot for GuideKit",
  "main": "./dist/guidekit-sdk.es.js",
  "module": "./dist/guidekit-sdk.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
