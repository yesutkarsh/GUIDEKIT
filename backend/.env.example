# =====================================================================
# GuideKit backend — environment configuration
# ---------------------------------------------------------------------
# Copy this file to `.env` (in the `backend/` directory) and fill in the
# values. The application loads `.env` via pydantic-settings.
#
#   cp .env.example .env
#
# EVERY variable below is read from the environment (or `.env`). Only
# DATABASE_URL and SECRET_KEY are strictly required to run against a live
# database; everything else has a safe development default.
# =====================================================================

# ---------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------
APP_NAME=GuideKit API
ENVIRONMENT=development            # development | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------------------------------------------------------------------
# Security — REQUIRED
# ---------------------------------------------------------------------
# Long, random secret used to sign JWTs (access tokens). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# In production this MUST be set and must NOT be the development default.
SECRET_KEY=change-me-to-a-long-random-secret

# Access token (JWT) lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30
# Device-code (VS Code extension login) lifetime in seconds.
DEVICE_CODE_EXPIRE_SECONDS=900
# URL shown to the human during device-code login (the dashboard approve page).
DASHBOARD_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Database — REQUIRED to run migrations / smoke tests
# ---------------------------------------------------------------------
# Paste your Neon connection string here. It must point at a database where the
# `pgcrypto` and `pgvector` extensions can be created (Neon supports both).
#
#   postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
#
# NOTE: the `+psycopg` scheme is required by SQLAlchemy's async engine. The
# plain `scripts/init_db.py` accepts either the `+psycopg` form or a plain
# `postgres://` URI.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/guidekit?sslmode=require

# Connection pool tuning (SQLAlchemy async engine).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# ---------------------------------------------------------------------
# CORS — comma-separated list of allowed browser origins for the dashboard
# ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# Clerk Authentication (Phase 6)
# ---------------------------------------------------------------------
# Optional in dev; when provided, FastAPI verifies Clerk RS256 session tokens.
# CLERK_SECRET_KEY=sk_test_...
# CLERK_JWKS_URL=https://api.clerk.com/v1/jwks
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
# CLERK_ISSUER=https://your-clerk-frontend-api.clerk.accounts.dev
# CLERK_AUDIENCE=
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------
# LLM & Intent Detection (Inception Labs Mercury 2.5 / OpenAI)
# ---------------------------------------------------------------------
# LLM_API_KEY=il_live_...
LLM_BASE_URL=https://api.inceptionlabs.ai/v1
LLM_MODEL=mercury-2.5
